# 服务
PORT=3010
NODE_ENV=production
API_BASE_PATH=/api

# JWT（至少 32 位随机字符串）
JWT_SECRET=change-this-socketai-jwt-secret-in-production

# PostgreSQL（独立库 socketai，勿与 zjunanashi 混用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socketai
DB_USER=socketai_app
DB_PASSWORD=your-database-password

# CORS（前端域名，逗号分隔）
CORS_ORIGIN=https://mugzju.top,http://localhost:5500

# 是否开放机构自助注册（true/false）
ALLOW_PUBLIC_REGISTER=false

# 上传目录（STL/OBJ/导出文件）
SOCKETAI_UPLOAD_DIR=./uploads

# Gemini AI 复核（可选；未配置时 /api/gemini-refine 返回错误，前端可走本地兜底）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 初始管理员（仅 create-admin 脚本使用，勿写入前端）
ADMIN_EMAIL=admin@your-org.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请使用强密码并通过环境变量注入
